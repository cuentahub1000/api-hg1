# Local run of the HTTP runtime (the local shim front-self reaches with
# API_HG_MODE=http, API_HG_URL=http://localhost:8080):
#   cp .env.example .env                                  then fill the empty values
#   docker compose -f infra/docker-compose.yml up -d      own Postgres on 5433
#   npm run migrate                                       creates the tables
#   npm run server                                        starts on PORT

PORT=8080
LOG_LEVEL=debug

# Platform JWT secret — the same bytes login-auth signs with. With front-self
# in AUTH_MOCK, use its AUTH_MOCK_JWT_SECRET / NEXTAUTH_SECRET instead. In AWS
# use JWT_SECRET_ARN=<env>/JWTSecret and leave this unset.
JWT_SECRET=

# Own database (Postgres). In AWS the function stacks set DB_HOST/PORT/NAME
# and DB_SECRET_ARN=<env>/HgDatabase/postgres; locally give user/password.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=payments
DB_SSL=disable

# Payment provider (hg.cash). Production https://hg.cash/api/v1, development http://dev.hg.cash/api/v1
PROVIDER_API_URL=https://hg.cash/api/v1
PROVIDER_API_TOKEN=
PROVIDER_WEBHOOK_SECRET=
PROVIDER_ACCOUNT_ID=
# Public URL the provider calls back (this service's /api/v1/payments/webhook)
PROVIDER_WEBHOOK_URL=
PAYMENTS_COUNTRY=AR
PAYMENTS_CURRENCY=ARS

# Where the hosted payment page returns the player (front-self)
PAYMENTS_RETURN_URL=http://localhost:9100/wallet/deposit/return
PAYMENTS_CANCEL_URL=http://localhost:9100/wallet/deposit/return

# Wallet, through its API only. lambda: invoke ${WALLET_FUNCTION_PREFIX}<slug>
# with the AWS credentials of this shell (same as front-self's lambda mode);
# http: ${WALLET_API_URL}/api/v1/...
WALLET_MODE=lambda
WALLET_FUNCTION_PREFIX=<env>-wallet-
WALLET_REGION=us-east-1
WALLET_API_URL=
# x-api-key of a wallet user allowed to read parties and create/transition operations
WALLET_API_KEY=

PAYMENTS_UPSTREAM_TIMEOUT_MS=10000
PAYMENTS_RECHECK_AFTER_MS=60000
# Set when the service is mounted under a path prefix by the ingress.
#PAYMENTS_PATH_PREFIX=/api-hg
