# Environment for `npm run local` — the local invoke shim AND every handler it
# runs (they share the process). Copy to local/lambda.env (gitignored).
# Node's --env-file never overrides a variable already set in the shell.

# ---- the shim ---------------------------------------------------------------
LOCAL_LAMBDA_PORT=9500
LOCAL_SECRETS_FILE=local/secrets.json

# ---- AWS SDK ---------------------------------------------------------------
# Only Secrets Manager is served by the shim. The Lambda client (wallet in
# WALLET_MODE=lambda) keeps the shell's real AWS credentials/endpoint.
AWS_REGION=us-east-1
# the SDK needs credentials even for the shim; never checked
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL_SECRETS_MANAGER=http://127.0.0.1:9500

# ---- own database (docker compose -f infra/docker-compose.yml up -d) -------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=payments
DB_SECRET_ARN=local/HgDatabase
DB_SSL=disable

# ---- secrets (names resolved from LOCAL_SECRETS_FILE) ----------------------
HG_SECRET_ARN=local/HgSecrets
# MUST equal what the front-ends sign with (front-self AUTH_MOCK:
# AUTH_MOCK_JWT_SECRET / NEXTAUTH_SECRET; real login: the platform JWT secret).
JWT_SECRET=

# ---- payment provider (hg.cash) ----------------------------------------------
# mock = in-process sandbox (fake hosted page on the shim, no credentials); live = hg.cash
PROVIDER_MODE=mock
# the fake payment page completes payments with no check: explicit opt-in, and never with a production wallet
SANDBOX_ENABLED=1
SANDBOX_ALLOW_REAL_WALLET=1
# balance the sandbox provider account reports to the withdrawal queue (default: never short)
#SANDBOX_PROVIDER_BALANCE=50000
PROVIDER_API_URL=https://hg.cash/api/v1
PROVIDER_ACCOUNT_ID=
# hg.cash cannot reach a laptop; leave empty, or an ngrok-style URL to http://127.0.0.1:9500/webhook
PROVIDER_WEBHOOK_URL=
PAYMENTS_COUNTRY=AR
PAYMENTS_CURRENCY=ARS
PAYMENTS_RETURN_URL=http://localhost:9100/wallet/deposit/return
PAYMENTS_CANCEL_URL=http://localhost:9100/wallet/deposit/return

# ---- wallet, through its API only --------------------------------------------
# mock: in-process sandbox wallet, one account per party, WALLET_MOCK_BALANCE (default 100000) withdrawable
WALLET_MODE=mock
# http: the dev wallet. Calls forward the caller's JWT; WALLET_API_KEY (local/secrets.json) is for the webhook only
#WALLET_MODE=http
#WALLET_API_URL=http://192.168.122.129:3000/api-wallet/api/v1
# lambda: real wallet functions with the shell's AWS credentials
#WALLET_MODE=lambda
#WALLET_FUNCTION_PREFIX=<env>-wallet-

LOG_LEVEL=debug

# --- security checks (api-auth + api-security databases, read only) --------
# The session check reads `Session` from api-auth:
#AUTH_DB_HOST=127.0.0.1
#AUTH_DB_PORT=5432
#AUTH_DB_NAME=api-auth
#AUTH_DB_USER=
#AUTH_DB_PASSWORD=
# The operator feature check reads User/Role/Feature from api-security:
# Every call checks the token's session and, for operator writes, the role's
# features. Point these at an api-security database to run the real checks:
#SECURITY_DB_HOST=127.0.0.1
#SECURITY_DB_PORT=5432
#SECURITY_DB_NAME=api-security
#SECURITY_DB_USER=
#SECURITY_DB_PASSWORD=
# Local sandbox ONLY (PROVIDER_MODE=mock): skip both checks. Ignored in any other mode.
SANDBOX_SKIP_SECURITY_DB=1
