{
  "name": "api-hg",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Payments service: hosted-checkout deposits and bank cash-out withdrawals, as per-endpoint AWS Lambdas or one HTTP service",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/tests/unit/*.test.js'",
    "server": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env dist/server/index.js",
    "migrate": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env dist/scripts/migrate.js",
    "local": "node --env-file=local/lambda.env --watch-path=lambdas --watch-path=local/server.cts local/server.cts",
    "migrate:local": "tsc -p tsconfig.server.json && DB_USER=payments DB_PASSWORD=payments node --env-file=local/lambda.env dist/scripts/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.21.5",
    "typescript": "~5.6.0"
  }
}
